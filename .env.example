# Copy to .env and adjust. Never commit real secrets.

# --- required secrets (generate with: openssl rand -base64 48) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
INTERNAL_TOKEN=change-me-internal-service-token
POSTGRES_PASSWORD=change-me

# --- AI provider: fallback | openai | anthropic ---
# fallback needs no key: it matches questions to the built-in catalog and returns labelled reference solutions.
AI_PROVIDER=fallback
AI_MODEL=
AI_API_KEY=
# Optional: any OpenAI-compatible endpoint (e.g. a local model server)
AI_BASE_URL=

# --- code execution sandbox: docker (isolated) | local (DEV ONLY, not isolated) ---
EXECUTION_SANDBOX=docker
EXECUTION_IMAGE=eclipse-temurin:21-jdk-alpine

# --- frontend origin(s) allowed by CORS (comma separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set true behind HTTPS so the refresh cookie is Secure
COOKIE_SECURE=false
